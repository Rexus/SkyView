{
  "analysis": "InvertedPendulum::Studies::swingUpResponse",
  "blocks": [
    {
      "doc": "Kick breaks the exact downward equilibrium; energy shaping with cart centering\nthen captures with LQR. Angle/speed gates and release hysteresis select modes.\nInvalid sensing latches Disabled and commands zero; restart requires a new run.",
      "model": "InvertedPendulum::ControlLoop::controller",
      "name": "controller",
      "type": "Controller"
    },
    {
      "doc": "Saturation at +/-forceLimit followed by lag 1/(tau*s+1); zero initial force.",
      "model": "InvertedPendulum::ControlLoop::actuator",
      "name": "actuator",
      "type": "Actuator"
    },
    {
      "doc": "Add actuator force and the externally applied horizontal disturbance.",
      "model": "InvertedPendulum::ControlLoop::sum",
      "name": "sum",
      "type": "ForceSum"
    },
    {
      "doc": "Coupled nonlinear cart/rod equations and state integration; not two independent plants.\nIncludes gravity, uniform-rod inertia, centrifugal coupling, cart and pivot damping.",
      "model": "InvertedPendulum::ControlLoop::plant",
      "name": "plant",
      "type": "Plant"
    },
    {
      "doc": "Sample and quantize position/angle; validity false at injected sensor fault.\nNo angle wrapping in the measurement, no delay beyond the sampling period.",
      "model": "InvertedPendulum::ControlLoop::encoders",
      "name": "encoders",
      "type": "Encoders"
    },
    {
      "doc": "Backward differences of sampled positions with first-order low-pass velocity filters.\nInitial velocities equal the specified initial conditions. Validity propagates.",
      "model": "InvertedPendulum::ControlLoop::estimator",
      "name": "estimator",
      "type": "Estimator"
    },
    {
      "doc": "Zero in nominal run; rectangular horizontal force pulse in disturbance test.",
      "model": "InvertedPendulum::ControlLoop::disturbance",
      "name": "disturbance",
      "type": "Disturbance"
    }
  ],
